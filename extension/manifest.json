{
  "manifest_version": 3,
  "name": "Invoice # Scraper & Auto-Copier",
  "version": "3.1.0",
  "description": "Floating invoice input, invoice-number scraping and auto-copy for DVLA and Genesys pages.",
  "key": "",
  "update_url": "https://raw.githubusercontent.com/armnet122/invoice-scraper-extension/main/updates.xml",
  "permissions": [
    "storage",
    "clipboardWrite",
    "contextMenus",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "*://dvla.gov.gh/*",
    "*://*.dvla.gov.gh/*",
    "*://*.genesys.com/*",
    "*://*.genesyscloud.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "*://*/*"
  ],
  "storage": {
    "managed_schema": "schema.json"
  }
}